{
  "name": "asteroid",
  "private": true,
  "workspaces": [
    "theme",
    "settings-app"
  ],
  "scripts": {
    "build": "npm run build -w theme",
    "test:responsive": "npm run build && playwright test --config tests/responsive/playwright.config.cjs",
    "dev": "npm run dev -w theme",
    "deploy": "npm run deploy -w theme && npm run publish-snippets -w settings-app",
    "settings": "npm run start -w settings-app",
    "tunnel": "npm run tunnel -w settings-app",
    "snapshots": "NODE_PATH=node_modules npx -y node@20 tests/shop/snapshots.cjs",
    "preview:blank": "npm run build && node tests/shop/blank-preview.mjs",
    "audit": "NODE_PATH=node_modules npx -y node@20 tests/shop/audit.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
